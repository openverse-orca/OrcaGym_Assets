    <!-- 左夹爪：两个手指对称开合（-1 表示相反方向）-->
    <!-- solref 和 solimp 参数确保约束有足够的柔性和精度，允许完全闭合 -->
    <!-- solref="0.01 1" 使用更小的误差容差，确保闭合时更精确 -->
    <joint joint1="left_gripper_finger_joint1" joint2="left_gripper_finger_joint2" 
