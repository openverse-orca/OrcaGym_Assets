      <joint joint="left_gripper_finger_joint1" coef="1"/>
      <joint joint="left_gripper_finger_joint2" coef="-1"/>
    </fixed>

    <!-- 右夹爪 tendon：两个手指对称移动 -->
    <fixed name="r_split"  limited="true" range="-0.03 0.05">
      <joint joint="right_gripper_finger_joint1" coef="1"/>
      <joint joint="right_gripper_finger_joint2" coef="-1"/>
    </fixed>
  </tendon>
