<?xml version="1.0" ?>
<mujoco model="multi_physics_field_example">
    <compiler angle="radian" meshdir="meshes"/>
    
    <!-- Asset definitions -->
    <asset>
        <!-- SPH 侧使用的简化 mesh 文件（.obj 格式） -->
        <mesh name="sphere" file="sphere.obj" scale="0.2 0.2 0.2"/>
        <mesh name="box" file="UnitBox.obj" scale="0.3 0.3 0.3"/>
    </asset>
    
    <!-- Default class definitions -->
    <default>
        <!-- SPH 多点软连接标记 class -->
        <!-- 这个 geom 不参与碰撞，不可见，仅用于标记和参数传递 -->
        <default class="SPH_MULTI_POINT_CONNECTOR">
            <geom contype="0" conaffinity="0" group="3" type="mesh"/>
        </default>
        <default class="visual">
            <geom contype="0" conaffinity="0" group="1" type="mesh"/>
        </default>
        <default class="collision">
            <geom contype="1" conaffinity="1" group="3" type="mesh"/>
        </default>
    </default>
    
    <worldbody>
        <!-- 示例 1: 球体 -->
        <body name="sphere_body" pos="0 0 1">
            <!-- 普通渲染几何体 -->
            <geom name="sphere_visual" class="visual" rgba="0.9 0.1 0.1 1" mesh="sphere"/>
            
            <!-- 可选：碰撞几何体 -->
            <geom name="sphere_collision" class="collision" mesh="sphere"/>
            
            <!-- SPH 多点软连接标记
                 class="SPH_MULTI_POINT_CONNECTOR" - 自动识别标记
                 mesh="sphere_sph_mesh" - 对应 asset 中的 mesh 名称
                 user="0.5" - tetrahedronRadius 参数（单位：米）
            -->
            <geom name="sphere_sph_connector" class="SPH_MULTI_POINT_CONNECTOR" 
                  mesh="sphere" 
                  size="0.2"
                  user="0.3"/>
            
            <!-- 自由关节（可选，如果需要浮动物体） -->
            <freejoint/>
        </body>
        
        <!-- 示例 2: 立方体 -->
        <body name="box_body" pos="2 0 1">
            <!-- 普通渲染几何体 -->
            <geom name="box_visual" class="visual" rgba="0.1 0.9 0.1 1" mesh="box"/>

            <geom name="box_collision" class="collision" mesh="box"/>
            
            <!-- SPH 多点软连接标记（半径 0.3 米） -->
            <geom name="box_sph_connector" class="SPH_MULTI_POINT_CONNECTOR" 
                  mesh="box" 
                  size="0.3 0.3 0.3"
                  user="0.4"/>
            
            <freejoint/>
        </body>
    </worldbody>
</mujoco>